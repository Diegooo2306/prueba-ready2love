-- =========================================
-- POSTGRESQL - USERS LOV001
-- id_user VARCHAR generado autom�tico
-- IGNORA cualquier id_user manual
-- =========================================

-- 1) SEQUENCE
CREATE SEQUENCE seq_users_lov
START 1
INCREMENT 1;

-- 2) FUNCI�N GENERADORA LOV001
CREATE OR REPLACE FUNCTION generar_lov_id()
RETURNS VARCHAR AS $$
BEGIN
    RETURN 'LOV' || LPAD(nextval('seq_users_lov')::text, 3, '0');
END;
$$ LANGUAGE plpgsql;

-- 3) TABLA USERS
CREATE TABLE users (
    id_user VARCHAR(10) PRIMARY KEY DEFAULT generar_lov_id(),
    fecha_registro DATE NOT NULL DEFAULT CURRENT_DATE,

    nombre VARCHAR(255) NOT NULL,
    apellido1 VARCHAR(36),
    apellido2 VARCHAR(36),

    email VARCHAR(50) UNIQUE NOT NULL,
    password VARCHAR(255) NOT NULL,

    rol NUMERIC(1,0) DEFAULT 0,
    edad NUMERIC(2,0),
    genero VARCHAR(10),
    estado_civil VARCHAR(10),
    ndec NUMERIC(2,0),
    status NUMERIC(1,0) DEFAULT 1
);

-- 4) TRIGGER: SIEMPRE genera el id_user (aunque intenten mandarlo)
CREATE OR REPLACE FUNCTION forzar_id_user_auto()
RETURNS TRIGGER AS $$
BEGIN
    NEW.id_user := generar_lov_id();
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_forzar_id_user_auto
BEFORE INSERT ON users
FOR EACH ROW
EXECUTE FUNCTION forzar_id_user_auto();

